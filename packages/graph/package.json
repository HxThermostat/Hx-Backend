{
  "name": "graph",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node -r dotenv/config dist/index.js",
    "build": "yarn build-graph && yarn build-ts",
    "build-ts": "tsc --skipLibCheck",
    "build-graph": "graphql-codegen --config codegen.yml",
    "watch-ts": "tsc -w --skipLibCheck",
    "watch-graph": "graphql-codegen --watch --config codegen.yml",
    "watch-node": "nodemon -r dotenv/config dist/index.js",
    "clean": "rm -Rf dist/*",
    "test": "jest",
    "postinstall": "test -n \"$SKIP_POSTINSTALL\" || patch-typed-document-node"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.0.0",
    "@aws-sdk/util-arn-parser": "^3.0.0",
    "actions-on-google": "^2.13.0",
    "agentkeepalive": "^4.1.3",
    "apollo-server-express": "^2.19.2",
    "axios": "^0.19.2",
    "axios-retry": "^3.2.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.5",
    "dataloader": "^2.0.0",
    "dd-trace": "^0.28.1",
    "dotenv": "^8.2.0",
    "env-var": "^6.1.1",
    "express-http-to-https": "^1.1.4",
    "geo-tz": "^6.0.1",
    "glob": "^7.1.6",
    "hot-shots": "^8.2.0",
    "jose": "^1.27.1",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.19",
    "otplib": "^12.0.1",
    "pug": "^3.0.2",
    "safe-compare": "^1.1.4",
    "unique-names-generator": "^4.6.0",
    "uuid": "^8.3.2",
    "zod": "2.0.1-alpha.3"
  },
  "devDependencies": {
    "@graphql-typed-document-node/core": "^3.1.0",
    "@graphql-typed-document-node/patch-cli": "^3.0.8",
    "@pollyjs/adapter-node-http": "^4.3.0",
    "@pollyjs/core": "^4.3.0",
    "@pollyjs/persister-fs": "^4.3.0",
    "@types/compression": "^1.7.2",
    "@types/cookie-parser": "^1.4.2",
    "@types/express": "^4.17.11",
    "@types/glob": "^7.1.1",
    "@types/jest": "^26.0.0",
    "@types/jsonwebtoken": "^8.5.0",
    "@types/lodash": "^4.14.155",
    "@types/pollyjs__adapter-node-http": "^2.0.0",
    "@types/pollyjs__core": "^4.3.0",
    "@types/pollyjs__persister-fs": "^2.0.0",
    "@types/safe-compare": "^1.1.0",
    "@types/setup-polly-jest": "^0.5.0",
    "@types/uuid": "^8.3.0",
    "apollo-server-testing": "^2.19.2",
    "graphql": "^15.0.0",
    "jest": "^26.0.1",
    "jest-config": "^26.0.1",
    "jest-date-mock": "^1.0.8",
    "nodemon": "^2.0.4",
    "setup-polly-jest": "^0.7.0",
    "ts-jest": "^26.1.0",
    "utility-types": "^3.10.0"
  }
}
