source "https://rubygems.org"

# We need at least 2.183 for Ruby 3 support on app center builds
gem "fastlane", '>= 2.183'
gem "dotenv"
gem "rest-client" # required by sentry plugin for uploading dsyms
gem 'aws-sdk-s3', '~> 1'
gem 'aws-sdk-cloudfront', '~> 1'

plugins_path = File.join(File.dirname(__FILE__), 'fastlane', 'Pluginfile')
eval_gemfile(plugins_path) if File.exist?(plugins_path)
